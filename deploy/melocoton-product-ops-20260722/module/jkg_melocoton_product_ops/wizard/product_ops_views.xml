<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jkg_melocoton_new_product_wizard_form" model="ir.ui.view">
        <field name="name">jkg.melocoton.new.product.wizard.form</field>
        <field name="model">jkg.melocoton.new.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Nuevo producto">
                <sheet>
                    <div class="oe_title">
                        <h1>Nuevo producto</h1>
                    </div>
                    <p>Introduce únicamente nombre, precio y EAN cuando exista. Odoo completará IVA, categoría, unidad, imagen, descripción y TPV.</p>
                    <group>
                        <field name="barcode" placeholder="Opcional"/>
                        <field name="name" placeholder="Nombre del artículo"/>
                        <field name="price" widget="monetary" options="{'currency_field': False}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_product" string="Crear y dejar listo" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jkg_melocoton_new_product" model="ir.actions.act_window">
        <field name="name">Nuevo producto</field>
        <field name="res_model">jkg.melocoton.new.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_jkg_melocoton_price_wizard_form" model="ir.ui.view">
        <field name="name">jkg.melocoton.price.wizard.form</field>
        <field name="model">jkg.melocoton.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar precio">
                <sheet>
                    <div class="oe_title">
                        <h1>Cambiar precio</h1>
                    </div>
                    <p>Solo cambia el precio de venta. IVA, categoría, unidad, imagen y resto de la ficha permanecen protegidos.</p>
                    <group>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="current_price" readonly="1"/>
                        <field name="new_price"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_change_price" string="Guardar precio" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jkg_melocoton_price" model="ir.actions.act_window">
        <field name="name">Cambiar precio</field>
        <field name="res_model">jkg.melocoton.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_jkg_melocoton_import_wizard_form" model="ir.ui.view">
        <field name="name">jkg.melocoton.import.wizard.form</field>
        <field name="model">jkg.melocoton.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Excel">
                <sheet>
                    <div class="oe_title">
                        <h1>Importar Excel</h1>
                    </div>
                    <p>El archivo solo necesita tres columnas: EAN, Nombre y Precio. EAN puede quedar vacío.</p>
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                        <field name="result_summary" readonly="1" invisible="not result_summary"/>
                        <field name="template_file" invisible="1"/>
                        <field name="template_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download_template" string="Descargar plantilla" type="object" class="btn-secondary"/>
                    <button name="action_import" string="Importar y dejar listos" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jkg_melocoton_import" model="ir.actions.act_window">
        <field name="name">Importar Excel</field>
        <field name="res_model">jkg.melocoton.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_jkg_melocoton_operation_log_list" model="ir.ui.view">
        <field name="name">jkg.melocoton.product.operation.log.list</field>
        <field name="model">jkg.melocoton.product.operation.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="operation"/>
                <field name="product_id"/>
                <field name="barcode" optional="hide"/>
                <field name="old_price" optional="show"/>
                <field name="new_price" optional="show"/>
                <field name="status"/>
                <field name="user_id"/>
                <field name="detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_jkg_melocoton_operation_log_form" model="ir.ui.view">
        <field name="name">jkg.melocoton.product.operation.log.form</field>
        <field name="model">jkg.melocoton.product.operation.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="operation"/>
                        <field name="product_id"/>
                        <field name="barcode"/>
                        <field name="old_price"/>
                        <field name="new_price"/>
                        <field name="status"/>
                        <field name="user_id"/>
                        <field name="detail"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jkg_melocoton_operation_log" model="ir.actions.act_window">
        <field name="name">Historial</field>
        <field name="res_model">jkg.melocoton.product.operation.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', '=', 10)]</field>
    </record>

    <menuitem id="menu_jkg_melocoton_ops_root" name="Gestión rápida" sequence="25" groups="base.group_user"/>
    <menuitem id="menu_jkg_melocoton_new_product" name="Nuevo producto" parent="menu_jkg_melocoton_ops_root" action="action_jkg_melocoton_new_product" sequence="10" groups="base.group_user"/>
    <menuitem id="menu_jkg_melocoton_import" name="Importar Excel" parent="menu_jkg_melocoton_ops_root" action="action_jkg_melocoton_import" sequence="20" groups="base.group_user"/>
    <menuitem id="menu_jkg_melocoton_price" name="Cambiar precio" parent="menu_jkg_melocoton_ops_root" action="action_jkg_melocoton_price" sequence="30" groups="base.group_user"/>
    <menuitem id="menu_jkg_melocoton_history" name="Historial" parent="menu_jkg_melocoton_ops_root" action="action_jkg_melocoton_operation_log" sequence="40" groups="base.group_user"/>
</odoo>
